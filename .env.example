# Set SECRET_KEY in your shell before starting Flask. Do not commit a real key.
SECRET_KEY=

# Keep false for local HTTP; set true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Local development and tests only. Production needs shared storage (for example,
# Redis) and its client library so limits are consistent across workers/restarts.
RATELIMIT_STORAGE_URI=memory://